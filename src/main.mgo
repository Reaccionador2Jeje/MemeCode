# MemeCode — punto de entrada en Memingo
vibe memecode_name = "MemeCode"
vibe memecode_version = "0.2.0"
vibe memecode_status = "memingo-core-ready"

ritual show_banner() {
    spill "================================"
    spill " MemeCode " + memecode_version
    spill " Agente de codigo con Memingo"
    spill "================================"
}

ritual show_status() {
    spill "Estado: " + memecode_status
    spill "Nucleo de politica: src/agent_core.mgo"
    spill "Adaptador de herramientas: runtime/agent.py"
    spill "La planificacion y las reglas principales se definen en Memingo."
}

show_banner()
show_status()
